# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Required. At least 32 random characters; the server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_db
# Set to true for Aiven (uses certs/aiven-ca.pem)
DB_SSL=false

# Groq API key for the AI assistant: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Orpheus voices include: autumn, diana, hannah, austin, daniel, troy
GROQ_TTS_VOICE=hannah
